# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# Shared by the panel and the bundled local agent; the panel registers it as node "local".
HEARTH_AGENT_TOKEN=

# Address your friends type to connect to servers on this machine (domain or public IP).
HEARTH_PUBLIC_HOST=localhost

# Folder on this computer where game servers are installed (worlds, mods, configs). Any drive:
#   Linux: /var/lib/hearth or /mnt/games/hearth   Windows: D:\Hearth   macOS: /Users/you/Hearth or /Volumes/Disk/Hearth
# The start scripts ask for this on the first run. Moving it later? Stop Hearth, move the folder, update this line.
HEARTH_DATA_DIR=/var/lib/hearth

# Port the web panel listens on.
HEARTH_PANEL_PORT=8000

# Optional: CurseForge modpacks (free key from https://console.curseforge.com/). Can also be set in Admin → Settings.
CURSEFORGE_API_KEY=

# Optional: how often to check for modpack updates, in minutes (default 360).
HEARTH_UPDATE_INTERVAL_MINUTES=360

# Set to true when the panel is served over HTTPS (behind Caddy, nginx, Traefik...).
HEARTH_COOKIE_SECURE=false

# Optional: session signing key. If empty, one is generated and stored in the database.
HEARTH_SECRET_KEY=

# Security switches (see docs/GUIDE.md, section 13). Defaults shown.
# HEARTH_ALLOW_REMOTE_SETUP=false      # create the first admin only from this machine / local network
# HEARTH_ALLOW_PRIVATE_WEBHOOKS=false  # webhooks may only go to internet addresses
# HEARTH_BREACHED_PASSWORD_CHECK=true  # refuse passwords found in known data breaches
